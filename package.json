{
  "name": "novatoria-entrepreneur-quiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "test": "node --test api/*.test.js",
    "content:verify": "node scripts/verify-content.cjs",
    "backend:check": "npm --prefix backend/yandex-function run check",
    "backend:test": "npm --prefix backend/yandex-function test",
    "backend:dev": "npm --prefix backend/yandex-function run dev",
    "verify": "npm run check && npm run test && npm run content:verify && npm run build && npm run backend:check && npm run backend:test"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.8.2",
    "vite": "^8.2.2"
  }
}
