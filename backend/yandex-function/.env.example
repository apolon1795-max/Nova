# Обязательные параметры Yandex Cloud Function
ALLOWED_ORIGINS=https://novatoria-quiz-2026.website.yandexcloud.net|https://nova-pi-eosin.vercel.app
YDB_CONNECTION_STRING=grpcs://ydb.serverless.yandexcloud.net:2135/?database=/ru-central1/REPLACE
YDB_TABLE_NAME=novatoria_quiz_leads

# Telegram: заполнить оба поля либо оставить оба пустыми.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Для заявки Новатории телефон должен приходить администратору.
TELEGRAM_INCLUDE_CONTACTS=true

# Укажите этот маршрут, если Cloud Functions не может обратиться к Telegram напрямую.
TELEGRAM_RELAY_URL=https://nova-pi-eosin.vercel.app/api/telegram-relay

# Только для локальной разработки. В облачной функции не устанавливать.
# LEAD_STORAGE_MODE=memory
